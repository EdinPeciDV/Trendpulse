# ─────────────────────────────────────────────────────────────
# Backend / services (Node) — services/fetchPrices.js
# Use the SERVICE ROLE key. Server-side only — never ship it to the frontend.
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────
# Frontend (Vite) — frontend/lib/supabaseClient.js
# Only the ANON key here. VITE_ vars are embedded in the client bundle.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
